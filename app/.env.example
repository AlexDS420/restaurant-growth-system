# Restaurant OS — variables de entorno (copiar a .env) — solo placeholders, nunca secretos reales
NODE_ENV=development
PORT=3000
# Ruta de la base de datos SQLite
DB_PATH=./data/restaurant-os.db
# Sesiones
SESSION_TTL_DAYS=7
# Pagos (adaptador mock: none|decline|outage)
PAYMENTS_MODE=mock
PAYMENTS_FAIL_MODE=none
PAYMENTS_OUTAGE_MAX_MS=0
# Rate limiting en endpoints públicos
RATE_LIMIT_ENABLED=true
# Solo activar detrás de un proxy inverso controlado que sobrescriba X-Forwarded-For
TRUST_PROXY=false
# Datos demo al arrancar una BD vacía (actívalo solo en desarrollo; `npm run seed` es explícito)
SEED_DEMO=false
# Outbox de notificaciones (worker en proceso)
OUTBOX_INTERVAL_MS=5000
OUTBOX_MAX_ATTEMPTS=5
# Admin de plataforma (sembrado si SEED_DEMO)
ADMIN_EMAIL=admin@restaurantos.pe
LOG_LEVEL=info
# Proveedor de mapas (adaptador; sin API key en demo)
MAP_PROVIDER=none
